# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 커밋하지 않는다 (공개 레포).
# 배포 서버(Render)에는 대시보드의 Environment 에 같은 이름으로 넣는다.

# 외부 Postgres 연결 주소
DATABASE_URL=

# 오픈뱅킹 테스트베드 (금융결제원)
OB_CLIENT_ID=
OB_CLIENT_SECRET=
# 테스트베드에 등록한 콜백 주소. 예: https://<배포주소>/api/expenses/bank/callback
OB_CALLBACK_URL=
# 이용기관코드
OB_ORG_CODE=
# 1 이면 모의 모드: 테스트베드를 부르지 않고 예시 거래내역을 돌려준다
OB_MOCK=1
